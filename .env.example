# Copy this file to .env and fill in the values. Never commit .env.

# The master key, sent in the x-api-key header. It can do everything: manage printers, create
# standard API keys, read logs and print. Use a long random value, e.g.:
#   openssl rand -hex 32
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
MASTER_KEY=
